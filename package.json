{
  "name": "@mirsella/context7-account-broker",
  "version": "0.4.0",
  "description": "Shared multi-account Context7 MCP for Linux x64",
  "type": "module",
  "exports": {
    "./server": "./plugin/context7.ts"
  },
  "bin": {
    "context7-account-broker": "vendor/context7-account-broker"
  },
  "files": [
    "plugin/",
    "vendor/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:native": "cargo build --locked --release --target x86_64-unknown-linux-musl",
    "stage:native": "install -Dm755 target/x86_64-unknown-linux-musl/release/context7-account-broker vendor/context7-account-broker",
    "test": "cargo test --locked && bun test tests/plugin.test.ts",
    "prepack": "pnpm build:native && pnpm stage:native"
  },
  "keywords": [
    "opencode",
    "context7",
    "mcp"
  ],
  "homepage": "https://github.com/mirsella/context7-account-broker#readme",
  "bugs": "https://github.com/mirsella/context7-account-broker/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirsella/context7-account-broker.git"
  },
  "license": "MIT",
  "author": "mirsella",
  "os": [
    "linux"
  ],
  "cpu": [
    "x64"
  ],
  "packageManager": "pnpm@10.14.0",
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
